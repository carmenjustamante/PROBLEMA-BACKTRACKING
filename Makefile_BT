# ==========================================
# MAKEFILE - BACKTRACKING (BT)
# ==========================================

# Compilador y banderas de optimización
CXX = g++
CXXFLAGS = -O3 -Wall -Wextra -std=c++11

# Nombres de los ejecutables finales
EXEC_TIEMPOS = medir_tiempos.exe
EXEC_TESTS = tests_unitarios_BT.exe
EXEC_ORACULO = test_oraculo_BT.exe


# Regla principal: compilar todo
all: $(EXEC_TIEMPOS) $(EXEC_TESTS) $(EXEC_ORACULO)
	@echo ==========================================
	@echo COMPILACION DE BACKTRACKING COMPLETADA
	@echo ==========================================

# Reglas de compilación individuales
$(EXEC_TIEMPOS): medir_tiempos.cpp reparto_camisetas_BT.h
	$(CXX) $(CXXFLAGS) medir_tiempos.cpp -o $(EXEC_TIEMPOS)

$(EXEC_TESTS): tests_unitarios_BT.cpp reparto_camisetas_BT.h
	$(CXX) $(CXXFLAGS) tests_unitarios_BT.cpp -o $(EXEC_TESTS)

$(EXEC_ORACULO): test_oraculo_BT.cpp reparto_camisetas_BT.h
	$(CXX) $(CXXFLAGS) test_oraculo_BT.cpp -o $(EXEC_ORACULO)

# Regla para limpiar los ejecutables y archivos CSV generados
clean:
	del /Q *.exe *.csv
	@echo Limpieza completada.
